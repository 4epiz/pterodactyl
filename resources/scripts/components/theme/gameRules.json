{
    "_comment": "Game detection rules, checked in order (first match wins) against the lower-cased egg name, then docker image, startup command and variable names. Shared by components/theme/games.ts and app/Services/Servers/GameDetector.php.",
    "rules": [
        {
            "game": "western",
            "pattern": "\\bredm\\b"
        },
        {
            "game": "gta",
            "pattern": "fivem|fxserver|txadmin|\\bgta\\b|rage ?mp|alt:?v\\b"
        },
        {
            "game": "minecraft",
            "pattern": "minecraft|paper|purpur|spigot|bukkit|forge|fabric|quilt|vanilla|bungee|velocity|waterfall|sponge|bedrock|nukkit|pocketmine|mohist|folia|neoforge|arclight|magma|catserver|ketting|pufferfish|travertine|flamecord|server_jarfile"
        },
        {
            "game": "terraria",
            "pattern": "terraria|tmodloader|tshock"
        },
        {
            "game": "rust",
            "pattern": "\\brust\\b|rustdedicated|oxide"
        },
        {
            "game": "ark",
            "pattern": "\\bark\\b|shootergame|\\basa\\b"
        },
        {
            "game": "valheim",
            "pattern": "valheim"
        },
        {
            "game": "fps",
            "pattern": "counter-?strike|\\bcs2\\b|csgo|srcds|garry|gmod|team ?fortress|\\btf2\\b|insurgency|left ?4 ?dead|l4d|squad|arma"
        },
        {
            "game": "survival",
            "pattern": "7 ?days|project ?zomboid|zomboid|dayz|unturned|the ?forest|sons ?of ?the ?forest|conan|palworld|v ?rising"
        },
        {
            "game": "voice",
            "pattern": "teamspeak|\\bts3\\b|mumble|murmur"
        },
        {
            "game": "database",
            "pattern": "mariadb|mysql|postgres|redis|mongo"
        },
        {
            "game": "code",
            "pattern": "discord|node|nodejs|python|bun\\b|deno|golang|\\bjava\\b|dotnet|\\bbot\\b"
        }
    ],
    "_platforms_comment": "Minecraft platforms, checked in order (first match wins) against the egg name, then the docker image, startup command and variable names. Decides which Minecraft addons a server gets: proxies have no server.properties and need proxy plugins; modded, vanilla, Sponge and Bedrock servers cannot use Bukkit plugins. A Minecraft server matching none of these is 'unknown' and gets every Minecraft addon.",
    "minecraft_platforms": [
        {
            "platform": "velocity",
            "pattern": "velocity"
        },
        {
            "platform": "bungee",
            "pattern": "bungee|waterfall|travertine|flamecord|lightfall"
        },
        {
            "platform": "bukkit",
            "pattern": "mohist|arclight|magma|catserver|ketting|youer|paper|purpur|spigot|bukkit|folia|pufferfish|tuinity|airplane|\\bleaf\\b|\\bgale\\b"
        },
        {
            "platform": "sponge",
            "pattern": "sponge"
        },
        {
            "platform": "modded",
            "pattern": "neoforge|forge|fabric|quilt"
        },
        {
            "platform": "bedrock",
            "pattern": "bedrock|pocketmine|nukkit|\\bbds\\b"
        },
        {
            "platform": "vanilla",
            "pattern": "vanilla"
        }
    ]
}
